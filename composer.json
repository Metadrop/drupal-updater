{
    "name": "metadrop/drupal-updater",
    "description": "Update drupal project dependencies",
    "type": "library",
    "bin": [
        "drupal-updater"
    ],
    "require": {
        "symfony/console": ">=4",
        "symfony/process": ">=4",
        "drush/drush": ">=10",
        "davidrjonas/composer-lock-diff": "^1.7"
    },
    "authors": [
        {
            "name": "Omar",
            "email": "omar.lopesino@metadrop.net"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "DrupalUpdater\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "DrupalUpdater\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
